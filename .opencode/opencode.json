{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "review": {
      "description": "Adversarially review and independently test the current task without modifying production code",
      "mode": "primary",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },

        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },

        { "action": "edit", "resource": "backend/tests/*", "effect": "allow" },
        { "action": "edit", "resource": "frontend/tests/*", "effect": "allow" },
        {
          "action": "edit",
          "resource": "frontend/src/*.test.*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "frontend/src/*.spec.*",
          "effect": "allow"
        },

        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },

        { "action": "shell", "resource": "cd backend *", "effect": "allow" },
        { "action": "shell", "resource": "cd frontend *", "effect": "allow" },

        {
          "action": "shell",
          "resource": "poetry run pytest *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "poetry run ruff check *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "poetry run mypy *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "poetry run basedpyright *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "poetry run pylint *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "poetry run lizard *",
          "effect": "allow"
        },

        {
          "action": "shell",
          "resource": "npm run test:run *",
          "effect": "allow"
        },
        { "action": "shell", "resource": "npm run lint *", "effect": "allow" },
        {
          "action": "shell",
          "resource": "npm run format:check *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run type-check *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm run quality:check *",
          "effect": "allow"
        },
        { "action": "shell", "resource": "npm run build *", "effect": "allow" },

        { "action": "shell", "resource": "*--fix*", "effect": "deny" },

        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
