{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:firebase-auth-emulator": "firebase --config ../firebase.json emulators:exec --only auth --project demo-dih-auth \"cd ../backend && FIREBASE_TEST_PROJECT_ID=demo-dih-auth poetry run pytest -m firebase_emulator\"",
    "quality:check": "npm run lint && npm run format:check && npm run type-check && npm run test:run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.8",
    "@tanstack/react-query-devtools": "^5.90.2",
    "ai": "^7.0.87",
    "firebase": "^12.17.1",
    "lucide-react": "^0.553.0",
    "next": "16.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.22",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "firebase-tools": "^15.28.2",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.7.3",
    "tailwindcss": "^3.4.18",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
