rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Conversations: only authenticated users (NO anonymous)
    match /conversations/{conversationId} {
      function signedInUser() {
        return request.auth != null
          && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
      }

      function validConversation(data) {
        return data.keys().hasOnly(['userId', 'name', 'history', 'createdAt', 'updatedAt', 'isPinned'])
          && data.keys().hasAll(['userId', 'name', 'history', 'createdAt', 'updatedAt'])
          && data.userId is string
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 120
          && data.history is list
          && data.history.size() <= 100
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && (!data.keys().hasAny(['isPinned']) || data.isPinned is bool);
      }

      allow read: if signedInUser() && request.auth.uid == resource.data.userId;
      allow create: if signedInUser()
                    && request.auth.uid == request.resource.data.userId
                    && validConversation(request.resource.data);
      allow update: if signedInUser()
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && validConversation(request.resource.data);
      allow delete: if signedInUser() && request.auth.uid == resource.data.userId;
    }

    // Deny access to all other collections for security
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
