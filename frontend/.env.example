# Local backend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/rag

# Firebase client configuration
# API key, auth domain, and project ID are required for the app to render.
# Replace these local placeholders with a Firebase web app's values to use auth.
NEXT_PUBLIC_FIREBASE_API_KEY=local-development
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=document-intelligent-hub-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=document-intelligent-hub-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:local
