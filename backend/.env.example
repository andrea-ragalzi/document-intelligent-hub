# LOCAL / DEV template only. Railway production values belong in Railway.

# === Runtime Environment ===
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated reverse-proxy IPs/CIDRs trusted to supply client IP headers.
# In production set this to the deployment proxy address; never use "*".
TRUSTED_PROXY_IPS=127.0.0.1

# === OpenAI API Configuration ===
# Required for RAG query processing and answer generation.
# Prefer a dedicated DEV key/project when available.
OPENAI_API_KEY=replace-with-dev-openai-key

# === RAG SYSTEM PROMPTS (🔒 LOADED FROM FILES) ===
# ⚠️ SECURITY: Prompts are stored in separate files (config/*.txt) that are git-ignored
# This keeps .env clean and protects proprietary prompt engineering
#
# SETUP:
# 1. Copy example files: cp config/*.txt.example config/*.txt
# 2. Customize prompts in config/*.txt files
# 3. (Optional) Override paths with environment variables below
#
# Default paths (auto-loaded if files exist):
#   - RAG_SYSTEM_PROMPT: ./config/rag_system_prompt.txt
#   - CLASSIFICATION_PROMPT: ./config/classification_prompt.txt
#   - QUERY_REFORMULATION: ./config/query_reformulation_prompt.txt
#
# To use different files (e.g., for A/B testing):
# RAG_SYSTEM_PROMPT_PATH=./config/prod_rag_prompt.txt
# CLASSIFICATION_PROMPT_PATH=./config/prod_classification.txt
# QUERY_REFORMULATION_PROMPT_PATH=./config/prod_reformulation.txt

# === Resend Configuration (Support Email Notifications) ===
# Optional: enables backend-only email notifications for bug reports and feedback.
# Create an API key and verify the sender domain in
# Resend before setting these values. Do not expose RESEND_API_KEY to the frontend.
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM_EMAIL="DIH <noreply@yourdomain.com>"
REPORT_RECIPIENT_EMAIL=support@yourdomain.com

# === ChromaDB Configuration ===
# Path to ChromaDB persistent storage
CHROMA_DB_PATH=./chroma_db_dev
# Original PDFs for authenticated preview/download. In Railway, use a mounted
# persistent volume path such as /data/uploads.
DOCUMENT_STORAGE_PATH=./chroma_db_dev/originals

# === LLM Model Selection ===
# OpenAI chat model used for query processing and answer generation
LLM_MODEL=gpt-4o-mini
# Bound every OpenAI call to one minute and never replay a failed paid call.
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=0

# Public-demo RAG concurrency control. It applies per backend process; Railway
# replicas would require a shared limiter for deployment-wide enforcement.
MAX_GLOBAL_EXPENSIVE_OPERATIONS=2

# Shared public demo. The five bundled synthetic PDFs are indexed once into
# a reserved namespace at startup and reused by every anonymous Firebase user.
ENABLE_SHARED_DEMO_CORPUS=true
# Local quality evaluation may query without daily UID, IP, or global ceilings.
# This setting is honored only when ENVIRONMENT=development; all other
# environments enforce quotas even if this value is false or omitted.
GUEST_DAILY_QUOTAS_ENABLED=false
GUEST_UID_DAILY_QUERY_LIMIT=8
GUEST_IP_DAILY_QUERY_LIMIT=20
GUEST_GLOBAL_DAILY_QUERY_BUDGET=100
MAX_CONCURRENT_GUEST_QUERIES=1

# === Firebase Admin (DEV only) ===
# Create this key in the dedicated DEV Firebase project. Never place a PROD
# service-account JSON in a local environment file.
FIREBASE_SERVICE_ACCOUNT_PATH=app/config/firebase-service-account.dev.json

# Production-only settings are intentionally omitted here. Railway supplies
# FIREBASE_CREDENTIALS, HF_HOME, prompt values and /data persistence paths.
