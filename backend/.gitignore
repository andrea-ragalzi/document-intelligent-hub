# Ambienti virtuali Poetry/venv
.venv

# Variabili d'ambiente (Non commettere le chiavi!)
.env*
!.env.example

# Credenziali Firebase locali (DEV o backup PROD)
app/config/firebase-service-account*.json
config/firebase-service-account*.json

# 🔒 SECURITY: Prompt files (contain proprietary prompt engineering)
config/*.txt

# Database e cache locali (ChromaDB)
chroma_db*/

# File specifici di Python
__pycache__/
*.pyc

# Log e cache di sistema
*.log
.DS_Store
