# Ignore files for Docker
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Environment files and local credentials must never enter an image build.
.env*
**/.env*
**/firebase-service-account.json
**/*service-account*.json
**/firebase-adminsdk-*.json
**/*credential*.json
**/credentials*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Repository metadata and generated local state
.git/
**/.git/
**/.cache/
**/.mypy_cache/

# Active prompts are local, git-ignored configuration. Deployment supplies
# them externally; tracked *.txt.example templates remain in the context.
config/*.txt

# ChromaDB (will be mounted as volume)
chroma_db*/

# Private user originals are runtime data, never image build input.
uploads/

# Logs
logs/
*.log
*.zip

# OS files
.DS_Store
Thumbs.db
