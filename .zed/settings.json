{
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "off",
      "preferred_line_length": 120
    }
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "diagnosticMode": "openFilesOnly"
        }
      }
    }
  },
  "context_servers": {
    "agentbus": {
      "command": "./.agentbus-venv/bin/agentbus",
      "args": ["mcp-serve", "--workspace", ".", "--wiretap"],
      "env": {
        "AGENTBUS_WORKSPACE": ".",
        "AGENTBUS_PRODUCER_ID": "mateo"
      }
    }
  }
}
